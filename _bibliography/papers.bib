@article{PhysRev.47.777,
  abbr              = {IJRC},
  title             = {Underwater Waste Detection Using Deep Learning: A Performance Comparison of YOLOv7–10 and Faster R-CNN},
  author            = {Nawarathne, UMMPK. and Kumari, HMNS. and Kumari, HMLS.},
  abstract          = {Underwater pollution is one of today’s most significant environmental concerns, with vast volumes of garbage found in seas, rivers, and landscapes around the world. Accurate detection of these waste materials is crucial for successful waste management, environmental monitoring, and mitigation strategies.
In this study, we investigated the performance of five cutting-edge object recognition algorithms, namely YOLO (You Only Look Once) models, including YOLOv7, YOLOv8, YOLOv9, YOLOv10, and Faster Region-Convolutional Neural Network (Faster R-CNN), to identify which model was most effective at recognizing materials in underwater situations.
The models were thoroughly trained and tested on a large dataset containing fifteen different classes under diverse conditions, such as low visibility and variable depths. Among the evaluated models, YOLOv8 outperformed the others, achieving a mean Average Precision (mAP) of 80.9%, indicating significant performance.
This improved performance is attributed to YOLOv8’s architecture, which incorporates advanced features such as improved anchor-free mechanisms and self-supervised learning, allowing for more precise and efficient recognition of items in a variety of settings. These findings highlight YOLOv8’s potential as an effective tool in the global fight against pollution by improving detection capabilities and supporting the scalability of underwater cleanup operations.},
